{
  "middlewares": [],
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "GitHub MCP server for repository operations"
    },
    "openviking": {
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "X-API-Key": "$OPENVIKING_API_KEY"
      },
      "description": "Official OpenViking tools for explicit memory and resource operations"
    },
    "scholarflow-academic": {
      "enabled": false,
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "scholarflow_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "packages/scholarflow-mcp",
        "SCHOLARFLOW_CONTACT_EMAIL": "$SCHOLARFLOW_CONTACT_EMAIL",
        "SCHOLARFLOW_OPENALEX_API_KEY": "$SCHOLARFLOW_OPENALEX_API_KEY",
        "SCHOLARFLOW_HTTP_TIMEOUT_SECONDS": "20",
        "SCHOLARFLOW_JUDGE_API_KEY": "$SCHOLARFLOW_JUDGE_API_KEY",
        "SCHOLARFLOW_JUDGE_MODEL": "$SCHOLARFLOW_JUDGE_MODEL",
        "SCHOLARFLOW_JUDGE_ENDPOINT": "https://api.openai.com/v1/responses",
        "SCHOLARFLOW_JUDGE_TIMEOUT_SECONDS": "60"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 30,
      "tool_call_timeout": 45,
      "description": "Multi-source scholarly search, bounded PDF text extraction, deterministic quote location, and optional model-based claim-evidence assessment",
      "routing": {
        "mode": "prefer",
        "priority": 80,
        "keywords": [
          "paper",
          "literature review",
          "DOI",
          "arXiv",
          "论文",
          "文献综述"
        ]
      }
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": [
          "database",
          "SQL",
          "table",
          "订单",
          "用户"
        ]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": [
              "查库",
              "订单表",
              "指标"
            ]
          }
        }
      }
    },
    "long-running-reports": {
      "enabled": false,
      "type": "http",
      "url": "https://reports.example.com/mcp",
      "description": "Example ordinary MCP background-task contract",
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "task_toolsets": [
        {
          "name": "report-generation",
          "submit_tool": "submit_report",
          "status_tool": "get_report_status",
          "cancel_tool": "cancel_report"
        }
      ]
    }
  },
  "skills": {}
}
